{
  "name": "@agentresources/mcp",
  "version": "0.1.2",
  "mcpName": "io.github.sznt2010/agentresources-mcp",
  "description": "Operational Model Context Protocol (MCP) server + `ar` CLI for Agent Resources. Wraps Trust Card lookup, signed telemetry, memory verbs, signing-key management, and ships the `ar doctor` self-diagnostic.",
  "license": "MIT",
  "author": "Agent Resources",
  "homepage": "https://agentresources.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/sznt2010/agentresources-mcp.git",
    "directory": "."
  },
  "keywords": [
    "agent-resources",
    "mcp",
    "model-context-protocol",
    "trust-card",
    "agents",
    "cli"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "ar": "./bin/ar.js",
    "agent-resources-mcp": "./bin/agent-resources-mcp.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/server.ts src/cli/index.ts --format cjs,esm --dts --clean",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentresources/sdk": "^0.1.2",
    "@agentresources/verify": "^0.1.2",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=20"
  }
}
